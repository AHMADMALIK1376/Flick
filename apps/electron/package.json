{
  "name": "@flick/electron",
  "version": "1.0.0",
  "private": true,
  "description": "Flick desktop app: starts the Python backend and shows the React UI in its windows.",
  "main": "build/main/main.js",
  "scripts": {
    "build": "tsc",
    "start": "tsc && electron build/main/main.js",
    "dev": "tsc && electron build/main/main.js --dev-ui",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "tsc && electron-builder --win --publish never"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "typescript": "^5.3.3",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "com.flick.presentation",
    "productName": "Flick",
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "assets/**/*",
      "!build/**/*.test.*",
      "!build/**/*.map",
      "!build/**/*.d.ts"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "artifactName": "Flick-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Flick",
      "include": "installer/uninstall-cleanup.nsh"
    },
    "extraResources": [
      {
        "from": "../ui/dist",
        "to": "ui"
      },
      {
        "from": "../../backend/dist/flick-backend",
        "to": "backend"
      }
    ],
    "executableName": "Flick"
  },
  "author": "Flick team (Ahmad Malik, Muhammad Mehdi Kazmi, Abdullah)",
  "repository": {
    "type": "git",
    "url": "https://github.com/AHMADMALIK1376/Flick.git"
  }
}
